<Application x:Class="DictaMute.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#182235" />
    <SolidColorBrush x:Key="LineBrush" Color="#34425A" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="#101827" />
      <Setter Property="Foreground" Value="#E5EDF8" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5EDF8" /></Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A9BAD2" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,6,0,8" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#29486B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#456B94" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#365E89" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#86C8FF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101827" />
      <Setter Property="Foreground" Value="#E5EDF8" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#456B94" />
      <Setter Property="Padding" Value="7,5" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5EDF8" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#142035" />
      <Setter Property="Background" Value="#DFE9F5" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinHeight" Value="31" />
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#142035" /></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#E5EDF8" /></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#101827" />
      <Setter Property="Foreground" Value="#E5EDF8" />
      <Setter Property="RowBackground" Value="#152033" />
      <Setter Property="AlternatingRowBackground" Value="#1B2940" />
      <Setter Property="BorderBrush" Value="#34425A" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="RowHeight" Value="34" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#26374F" />
      <Setter Property="Foreground" Value="#E5EDF8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#E5EDF8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="#64CDB2" />
      <Setter Property="Background" Value="#101827" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Resources>
</Application>
