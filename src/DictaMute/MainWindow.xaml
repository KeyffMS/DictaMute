<Window x:Class="DictaMute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DictaMute" Width="1320" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Loaded="Presentation_Loaded"
        SourceInitialized="Presentation_SourceInitialized" Closed="Presentation_Closed">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <!-- Same header anatomy as SightAdapt.ConfigurationForm; product-specific content. -->
    <Border x:Name="SuiteHeader" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="5,0,0,0">
      <StackPanel Margin="26,18,24,14" VerticalAlignment="Center">
        <TextBlock Text="Aplikacje i profile dźwięku" FontSize="26.667" FontWeight="Bold" />
        <TextBlock Text="Wybierz źródła mikrofonu i aplikacje, które mają ściszać się lub zatrzymywać, gdy mówisz."
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,16,24,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12" MinHeight="68">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <CheckBox x:Name="AutomationEnabled" Style="{StaticResource SuiteSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    AutomationProperties.Name="Włącz automatykę dźwięku" ToolTip="Włącz lub wyłącz automatykę" Click="ToggleAutomation_Click" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="Tryb automatyczny" Style="{StaticResource Heading}" />
            <TextBlock Text="Reaguj na aktywność mikrofonu zgodnie z wybranym profilem." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border x:Name="AutomationStateBadge" Grid.Column="2" VerticalAlignment="Center" Padding="10,4" CornerRadius="7">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=AutomationEnabled, Path=IsChecked}" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock x:Name="AutomationStateText" FontSize="10.667" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="WYŁĄCZONA" /><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=AutomationEnabled, Path=IsChecked}" Value="True"><Setter Property="Text" Value="GOTOWA" /><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Profil" Style="{StaticResource Heading}" Margin="0,0,12,0" />
        <ComboBox x:Name="ProfileBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="ProfileBox_SelectionChanged" AutomationProperties.Name="Aktywny profil" />
        <TextBox x:Name="ProfileName" Grid.Column="2" Margin="12,0" ToolTip="Nazwa bieżącego profilu" AutomationProperties.Name="Nazwa bieżącego profilu" />
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Content="Nowy profil" Click="NewProfile_Click" />
          <Button Content="Usuń profil" Style="{StaticResource DangerButton}" Click="DeleteProfile_Click" Margin="0" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel Margin="0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="1">
              <StackPanel>
                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11,11,0,0" Padding="16,0" Height="46">
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=SourcesGrid, Path=Items.Count, StringFormat=LICZBA: {0}}" Style="{StaticResource CountLabel}" /><TextBlock Text="X — Źródła mikrofonu" FontWeight="SemiBold" FontSize="15.333" /></DockPanel>
                </Border>
                <Grid>
                  <DataGrid x:Name="SourcesGrid" Height="160" MinHeight="120" MaxHeight="180" IsReadOnly="True" AutomationProperties.Name="Skonfigurowane źródła mikrofonu">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="20" Height="20" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      <DataGridTextColumn Header="Aplikacja" Binding="{Binding Name}" Width="*" />
                      <DataGridTemplateColumn Header="Mikrofon" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Value="{Binding Peak}" Maximum="100" Height="6" Margin="4,0" ToolTip="{Binding Status}" AutomationProperties.Name="Poziom źródła mikrofonu" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel x:Name="SourcesEmptyState" Margin="24,62,24,10" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=SourcesGrid, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Dodaj pierwsze źródło" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="Uruchom rozmowę lub dyktowanie, a następnie wybierz aplikację poniżej." Style="{StaticResource Hint}" TextAlignment="Center" />
                  </StackPanel>
                </Grid>
                <StackPanel Margin="16,6,16,6">
                  <TextBlock Text="Aktywne aplikacje używające mikrofonu" Style="{StaticResource Hint}" />
                  <ComboBox x:Name="CaptureApps" DisplayMemberPath="Label" AutomationProperties.Name="Dostępne źródła mikrofonu" ToolTip="Uruchom rozmowę lub dyktowanie, aby zobaczyć proces używający mikrofonu." />
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="Dodaj źródło" Click="AddCapture_Click" IsEnabled="{Binding ElementName=CaptureApps, Path=HasItems}" />
                    <Button Content="Wybierz .exe" Click="BrowseSource_Click" />
                    <Button Content="Usuń" Click="RemoveSource_Click" Style="{StaticResource DangerButton}" Margin="0" />
                  </WrapPanel>
                  <TextBlock Text="Skrót dodaje proces aktywnego okna. Dla Win+H wybierz rzeczywisty proces mikrofonu z listy." Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="1">
              <StackPanel>
                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11,11,0,0" Padding="18,0" Height="52">
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=TargetsGrid, Path=Items.Count, StringFormat=LICZBA: {0}}" Style="{StaticResource CountLabel}" /><TextBlock Text="Y — Aplikacje docelowe" FontWeight="SemiBold" FontSize="15.333" /></DockPanel>
                </Border>
                <Grid>
                  <DataGrid x:Name="TargetsGrid" Height="160" MinHeight="120" MaxHeight="180" AutomationProperties.Name="Aplikacje docelowe i tryby reakcji">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Width="36" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="20" Height="20" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      <DataGridTextColumn Header="Aplikacja" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                      <DataGridComboBoxColumn x:Name="TargetModeColumn" Header="Tryb" SelectedItemBinding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource GridComboDisplay}" EditingElementStyle="{StaticResource GridComboEdit}" />
                      <DataGridTextColumn Header="ID sesji" Binding="{Binding MediaSessionId, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel x:Name="TargetsEmptyState" Margin="24,62,24,10" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=TargetsGrid, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Wybierz aplikacje do ściszania" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="Dodaj odtwarzacz i wybierz: Duck, Mute lub Pause." Style="{StaticResource Hint}" TextAlignment="Center" />
                  </StackPanel>
                </Grid>
                <StackPanel Margin="16,8,16,8">
                  <TextBlock Text="Aplikacje z sesją odtwarzania" Style="{StaticResource Hint}" />
                  <ComboBox x:Name="PlaybackApps" DisplayMemberPath="Label" AutomationProperties.Name="Dostępne aplikacje odtwarzające dźwięk" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="Dodaj cel" Click="AddPlayback_Click" IsEnabled="{Binding ElementName=PlaybackApps, Path=HasItems}" />
                    <Button Content="Wybierz .exe" Click="BrowseTarget_Click" />
                    <Button Content="Usuń" Click="RemoveTarget_Click" Style="{StaticResource DangerButton}" Margin="0" />
                  </WrapPanel>
                  <TextBlock Text="Duck — ściszenie; Mute — wyciszenie; Pause — pauza. Źródła X nigdy nie są celami. ID sesji jest opcjonalne." Style="{StaticResource Hint}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Czułość i powrót dźwięku" Style="{StaticResource Heading}" Margin="0,0,0,10" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ThresholdSlider, Path=Value, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" /><TextBlock Text="Próg mikrofonu" /></DockPanel><Slider x:Name="ThresholdSlider" Minimum="0" Maximum="100" Value="3" Margin="0,6,0,0" AutomationProperties.Name="Próg mikrofonu w procentach" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,24,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=HoldSlider, Path=Value, StringFormat={}{0:F1} s}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" /><TextBlock Text="Czas podtrzymania" /></DockPanel><Slider x:Name="HoldSlider" Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="0.5" Value="1.5" Margin="0,6,0,0" AutomationProperties.Name="Czas podtrzymania w sekundach" /></StackPanel>
                <StackPanel Grid.Column="2"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DuckSlider, Path=Value, StringFormat={}{0:F0}%}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold" /><TextBlock Text="Docelowy poziom Duck" /></DockPanel><Slider x:Name="DuckSlider" Minimum="0" Maximum="100" Value="20" Margin="0,6,0,0" AutomationProperties.Name="Poziom ściszenia w procentach" /></StackPanel>
              </Grid>
              <WrapPanel Margin="0,10,0,8">
                <CheckBox x:Name="AllExceptSources" Content="Wszystko poza X" Margin="0,0,20,0" VerticalAlignment="Center" />
                <TextBlock Text="Domyślny tryb globalny" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="GlobalModeBox" Width="110" AutomationProperties.Name="Domyślny tryb globalny" />
              </WrapPanel>
              <CheckBox x:Name="AnyMicrophone" Content="Reaguj na dowolną aplikację używającą mikrofonu (pomija listę X)" />
              <TextBlock Text="Próg mierzy poziom sygnału, nie rozpoznaje mowy. Szum lub klawiatura też mogą go przekroczyć." Style="{StaticResource Hint}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Expander x:Name="AdvancedOptions" Header="Skróty, sesje multimedialne i przejścia" Margin="0,12,0,10">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,8,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Dodaj do X" /><TextBox x:Name="SourceHotkey" Margin="0,6,0,0" AutomationProperties.Name="Skrót dodawania źródła" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Dodaj do Y" /><TextBox x:Name="TargetHotkey" Margin="0,6,0,0" AutomationProperties.Name="Skrót dodawania celu" /></StackPanel>
                  <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Włącz / wyłącz" /><TextBox x:Name="ToggleHotkey" Margin="0,6,0,0" AutomationProperties.Name="Skrót włączania automatyki" /></StackPanel>
                  <StackPanel Grid.Column="3"><TextBlock Text="Przejście głośności" /><Slider x:Name="FadeSlider" Minimum="0" Maximum="1000" SmallChange="10" LargeChange="50" Value="180" Margin="0,6,0,0" AutomationProperties.Name="Czas przejścia głośności w milisekundach" /><TextBlock Text="{Binding ElementName=FadeSlider, Path=Value, StringFormat={}{0:F0} ms}" Foreground="{StaticResource AccentHoverBrush}" /></StackPanel>
                </Grid>
                <TextBlock Text="Uruchom odtwarzanie, zaznacz cel Y i przypisz jego sesję, gdy identyfikator odtwarzacza nie odpowiada nazwie procesu." Style="{StaticResource Hint}" Margin="0,12,0,8" />
                <DockPanel><Button Content="Przypisz ID do celu" DockPanel.Dock="Right" Click="AssignMedia_Click" Margin="10,0,0,0" /><ComboBox x:Name="MediaSessions" AutomationProperties.Name="Sesje multimedialne do przypisania" /></DockPanel>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
        <StackPanel><DockPanel><TextBlock x:Name="PeakText" DockPanel.Dock="Right" Width="75" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock x:Name="StatusText" Text="Uruchamianie…" FontWeight="SemiBold" /></DockPanel>
          <ProgressBar x:Name="PeakBar" Maximum="100" Height="5" Margin="0,7,0,4" AutomationProperties.Name="Bieżący poziom mikrofonu" />
          <TextBlock x:Name="NoticeText" Foreground="{StaticResource TextMutedBrush}" FontSize="11.733" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <DockPanel x:Name="ActionBar" Grid.Row="4" Margin="0,10,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Do zasobnika" Click="Hide_Click" Style="{StaticResource GhostButton}" />
          <Button x:Name="SaveButton" Content="Zapisz i zastosuj" Click="Apply_Click" Style="{StaticResource PrimaryButton}" />
          <Button Content="Zakończ" Click="Exit_Click" Style="{StaticResource DangerButton}" Margin="0" />
        </StackPanel>
        <TextBlock Text="Zamknięcie okna nie zatrzymuje automatyki." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
      </DockPanel>
      <Border x:Name="ProjectInfoCard" Grid.Row="5" Style="{StaticResource Card}" Padding="16,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="DictaMute" Style="{StaticResource Heading}" /><TextBlock Text="Automatyczne ściszanie i pauzowanie dźwięku." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.733" Margin="0,3,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="KeyffMS / aiteracja.pl · MIT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.733" HorizontalAlignment="Right" />
            <TextBlock HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="11.733"><Hyperlink NavigateUri="https://github.com/KeyffMS/DictaMute" RequestNavigate="ProjectLink_RequestNavigate">Kod źródłowy DictaMute</Hyperlink></TextBlock>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
