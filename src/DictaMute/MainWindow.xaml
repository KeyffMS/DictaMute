<Window x:Class="DictaMute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DictaMute" Width="1200" Height="900" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <CheckBox x:Name="AutomationEnabled" DockPanel.Dock="Right" Content="Automatyka włączona"
                Click="ToggleAutomation_Click" VerticalAlignment="Center" FontSize="15" />
      <StackPanel>
        <TextBlock Text="DictaMute" FontSize="32" FontWeight="Bold" />
        <TextBlock Text="Mów bez ręcznego wyciszania muzyki." Foreground="#A9BAD2" />
      </StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
        <Button Content="Nowy profil" Click="NewProfile_Click" />
        <Button Content="Usuń profil" Click="DeleteProfile_Click" Margin="0" />
      </StackPanel>
      <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox x:Name="ProfileBox" Width="190" DisplayMemberPath="Name" SelectionChanged="ProfileBox_SelectionChanged" />
      <TextBox x:Name="ProfileName" Margin="12,0,0,0" ToolTip="Nazwa bieżącego profilu" />
    </DockPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock Text="X — Źródła mikrofonu" Style="{StaticResource Heading}" />
              <DataGrid x:Name="SourcesGrid" Height="190" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="32">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="20" Height="20" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Aplikacja" Binding="{Binding Name}" Width="*" />
                  <DataGridTemplateColumn Header="Mikrofon" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><ProgressBar Value="{Binding Peak}" Maximum="100" Height="8" Margin="8,0" ToolTip="{Binding Status}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Aktywne aplikacje używające mikrofonu:" Style="{StaticResource Hint}" />
              <ComboBox x:Name="CaptureApps" DisplayMemberPath="Label" ToolTip="Uruchom rozmowę lub dyktowanie, aby zobaczyć proces używający mikrofonu." />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Dodaj źródło" Click="AddCapture_Click" />
                <Button Content="Wybierz .exe" Click="BrowseSource_Click" />
                <Button Content="Usuń" Click="RemoveSource_Click" Margin="0" />
              </WrapPanel>
              <TextBlock Text="Skrót dodaje proces aktywnego okna. Dla Win+H wybierz rzeczywisty proces z listy powyżej." Style="{StaticResource Hint}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock Text="Y — Aplikacje docelowe" Style="{StaticResource Heading}" />
              <DataGrid x:Name="TargetsGrid" Height="190">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="32" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="20" Height="20" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Aplikacja" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                  <DataGridComboBoxColumn x:Name="TargetModeColumn" Header="Tryb" SelectedItemBinding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                  <DataGridTextColumn Header="ID sesji (opcjonalne)" Binding="{Binding MediaSessionId, UpdateSourceTrigger=PropertyChanged}" Width="145" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Aplikacje z sesją odtwarzania:" Style="{StaticResource Hint}" />
              <ComboBox x:Name="PlaybackApps" DisplayMemberPath="Label" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Dodaj cel" Click="AddPlayback_Click" />
                <Button Content="Wybierz .exe" Click="BrowseTarget_Click" />
                <Button Content="Usuń" Click="RemoveTarget_Click" Margin="0" />
              </WrapPanel>
              <TextBlock Text="Duck — ściszenie; Mute — wyciszenie; Pause — pauza odtwarzacza. Źródła X nigdy nie są celami." Style="{StaticResource Hint}" />
            </StackPanel>
          </Border>
        </Grid>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="Czułość i powrót dźwięku" Style="{StaticResource Heading}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Próg mikrofonu" />
                <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="100" Value="3" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ElementName=ThresholdSlider, Path=Value, StringFormat={}{0:F1}%}" Style="{StaticResource Hint}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,20,0">
                <TextBlock Text="Czas podtrzymania" />
                <Slider x:Name="HoldSlider" Minimum="0" Maximum="10" Value="1.5" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ElementName=HoldSlider, Path=Value, StringFormat={}{0:F1} s}" Style="{StaticResource Hint}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Docelowy poziom Duck" />
                <Slider x:Name="DuckSlider" Minimum="0" Maximum="100" Value="20" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ElementName=DuckSlider, Path=Value, StringFormat={}{0:F0}%}" Style="{StaticResource Hint}" />
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,4,0,10">
              <CheckBox x:Name="AllExceptSources" Content="Wszystko poza X" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Text="Domyślny tryb globalny:" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="GlobalModeBox" Width="100" />
            </WrapPanel>
            <CheckBox x:Name="AnyMicrophone" Content="Reaguj na dowolną aplikację używającą mikrofonu (pomija listę X)" />
            <TextBlock Text="Próg mierzy poziom sygnału, nie rozpoznaje mowy. Szum lub klawiatura też mogą go przekroczyć." Style="{StaticResource Hint}" />
          </StackPanel>
        </Border>
        <Expander Header="Skróty, sesje multimedialne i przejścia" Margin="0,16,0,12">
          <StackPanel Margin="16,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="Dodaj do X" /><TextBox x:Name="SourceHotkey" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Dodaj do Y" /><TextBox x:Name="TargetHotkey" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Włącz / wyłącz" /><TextBox x:Name="ToggleHotkey" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="Przejście głośności (ms)" /><Slider x:Name="FadeSlider" Minimum="0" Maximum="1000" Value="180" Margin="0,8,0,0" /><TextBlock Text="{Binding ElementName=FadeSlider, Path=Value, StringFormat={}{0:F0} ms}" /></StackPanel>
            </Grid>
            <TextBlock Text="Uruchom odtwarzanie, zaznacz cel Y i przypisz jego sesję. Potrzebne, gdy identyfikator odtwarzacza nie odpowiada nazwie procesu." Style="{StaticResource Hint}" />
            <DockPanel><Button Content="Przypisz ID do celu" DockPanel.Dock="Right" Click="AssignMedia_Click" Margin="10,0,0,0" /><ComboBox x:Name="MediaSessions" /></DockPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,10">
      <StackPanel>
        <DockPanel><TextBlock x:Name="PeakText" DockPanel.Dock="Right" Width="75" TextAlignment="Right" /><TextBlock x:Name="StatusText" Text="Uruchamianie…" FontWeight="SemiBold" /></DockPanel>
        <ProgressBar x:Name="PeakBar" Maximum="100" Height="6" Margin="0,8,0,4" />
        <TextBlock x:Name="NoticeText" Foreground="#A9BAD2" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="4" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Do zasobnika" Click="Hide_Click" />
        <Button Content="Zapisz i zastosuj" Click="Apply_Click" Background="#245C54" />
        <Button Content="Zakończ" Click="Exit_Click" Margin="0" />
      </StackPanel>
      <TextBlock Text="Zamknięcie okna nie zatrzymuje automatyki." Style="{StaticResource Hint}" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</Window>
